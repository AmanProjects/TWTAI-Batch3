{
  "mcpServers": {
    "docstats": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp/docstats-server.js"],
      "env": {
        "CACHE_DIR": "${CLAUDE_PLUGIN_DATA}/cache"
      }
    },
    "team-docs-api": {
      "type": "http",
      "url": "https://example.com/mcp",
      "headers": {
        "X-Client": "doc-toolkit"
      }
    }
  }
}
